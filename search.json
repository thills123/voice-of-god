---
layout: null
sitemap: false
---
{% assign searchable = site.posts | where_exp: "item", "item.search != false" %}
[
  {% for post in searchable %}
  {% assign cat = post.categories | first %}
  {% assign cat_slug = cat | slugify %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "category": {{ cat | jsonify }},
    "category_url": {% if cat %}{{ '/category/' | append: cat_slug | append: '/' | relative_url | jsonify }}{% else %}null{% endif %},
    "tags": {{ post.tags | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | truncate: 200 | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | truncate: 1200 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
